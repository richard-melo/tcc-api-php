{
    "name": "richard/expense-api",
    "description": "API REST de gerenciamento de gastos pessoais — TCC UNIVILLE",
    "type": "project",
    "require": {
        "php": ">=8.1",
        "firebase/php-jwt": "^6.10"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "phpstan/phpstan": "^1.11",
        "squizlabs/php_codesniffer": "^3.10"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test:unit": "phpunit --testsuite=Unit",
        "test:integration": "phpunit --testsuite=Integration",
        "test:functional": "phpunit --testsuite=Functional",
        "stan": "phpstan analyse src --level=6",
        "cs": "phpcs src --standard=PSR12"
    }
}
